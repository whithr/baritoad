{
  "name": "baritoad-relay",
  "private": true,
  "version": "1.0.0",
  "description": "baritoad's party relay and guest page (Cloudflare Workers)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "node scripts/build-guest.mjs",
    "dev": "node scripts/build-guest.mjs && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/build-guest.mjs && wrangler deploy",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/guest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "esbuild": "^0.25",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
