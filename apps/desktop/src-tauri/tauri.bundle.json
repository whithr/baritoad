{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "baritoad",
    "copyright": "baritoad contributors — GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "Karaoke from the songs you already have",
    "resources": {
      "runtime/DirectML.dll": "DirectML.dll",
      "runtime/LICENSE.txt": "LICENSE.txt",
      "runtime/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "tools/yt-dlp.exe": "tools/yt-dlp.exe",
      "tools/deno.exe": "tools/deno.exe",
      "tools/DENO-LICENSE.md": "tools/DENO-LICENSE.md",
      "tools/VERSIONS.json": "tools/VERSIONS.json",
      "tools/source/*": "tools/source/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
