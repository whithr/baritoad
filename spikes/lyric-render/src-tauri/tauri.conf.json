{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lyric-render-spike",
  "version": "0.1.0",
  "identifier": "com.karaoke.spike.lyricrender",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyric Render Spike",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
