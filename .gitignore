# Build output
target/
node_modules/
dist/
build/
# The desktop app uses pnpm (pnpm-lock.yaml); a stray `npm install` lockfile
# must not come back alongside it.
package-lock.json

# Audio & video — test songs are copyrighted, never commit them (CLAUDE.md hard rule)
# The whole testdata tree is excluded, not just audio extensions: pipeline
# outputs there (timing maps, LRC/ASS/UltraStar exports) embed full lyrics,
# which are copyrighted too.
spikes/testdata/
*.mp3
*.flac
*.wav
*.m4a
*.ogg
*.opus
*.aac
*.mp4
*.mkv
*.webm

# Model weights — mirrored, never in-repo (provenance in MODEL_LICENSES.md)
*.onnx
*.pt
*.pth
*.safetensors
*.ggml
*.gguf
weights/

# Library databases — per-user state, never in the repo
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# External tools Add from URL runs (yt-dlp, Deno) — downloaded by
# `pnpm fetch-tools`, never committed (src-tauri/tools/README.md)
apps/desktop/src-tauri/tools/*
!apps/desktop/src-tauri/tools/README.md
# Staged by `pnpm package` for the installer: DirectML.dll from the ort
# download, the license and the generated third-party notices.
apps/desktop/src-tauri/runtime/

# The party relay's build output and local wrangler state (services/relay).
services/relay/public/
services/relay/.wrangler/
services/relay/dist/

# Tauri build-time generated files (recreated by tauri-build on every build)
apps/desktop/src-tauri/gen/

# Python tooling noise (spike export scripts)
__pycache__/
*.pyc

# Business notes — pricing and monetization stay local (CLAUDE.md)
BUSINESS.md

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
